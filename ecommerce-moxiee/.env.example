# Copy this file to ".env" and fill it in with YOUR OWN Supabase project credentials.
# Never commit a filled-in ".env" file to a public repository.

# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Set to "true" only on a public demo/preview deployment used to sell this
# template — shows a banner telling visitors it's a demo and how to safely
# try checkout. Leave unset (or "false") on a real client's live store.
VITE_DEMO_MODE=false
